# Copy this file to .env.local and fill in the values from your self-hosted
# Supabase instance. .env.local is gitignored - never commit real values.

# Base URL of your self-hosted Supabase API gateway (Kong), e.g.
# https://supabase.yourcompany.com or http://<host>:8000
NEXT_PUBLIC_SUPABASE_URL=

# The `anon` / public API key. Safe to expose in the browser - Row Level
# Security policies are what actually protect your data with this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The `service_role` key. Bypasses Row Level Security entirely - server-side
# only, never expose this to the browser. Used by src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by the Supabase CLI to run
# migrations (supabase db push --db-url) and by any migration/ORM tooling.
# Format: postgresql://postgres:[password]@[host]:[port]/postgres
DATABASE_URL=

# TEMPORARY, development only. Set to "true" to render protected pages with a
# stub identity instead of requiring a real login - useful while the
# self-hosted Supabase API is unreachable. Ignored entirely when
# NODE_ENV=production. See src/lib/dev-auth.ts; delete once auth works again.
DEV_AUTH_BYPASS=
